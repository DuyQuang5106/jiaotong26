* text=auto
*.py text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.csv text eol=lf
*.xlsx binary
*.png binary
# Preserve authoritative input bytes and their published checksums.
traffic-data-research/input/** -text
data/** -text
# Keep alignment whitespace in verbatim generated analytics transcripts.
traffic-data-research/reports/**/skill_outputs/*.txt whitespace=-blank-at-eol,-blank-at-eof
